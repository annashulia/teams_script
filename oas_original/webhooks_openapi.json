    "/Webhook.svc/Create": {
      "post": {
        "summary": "Create a Webhook",
        "operationId": "create_a_webhook",
        "tags": [
          "Webhooks"
        ],
        "description": "Creates a new webhook in your LeadSquared account.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
