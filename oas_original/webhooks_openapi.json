                  "Method": {
                    "type": "string",
                    "description": "The HTTP method, which will always be `POST` in this case."
                  },
                  "ContentType": {
                    "type": "string",
                    "description": "The format you want the data to be posted in. Supported formats are `application/json`, `application/x-www-form-urlencoded`, and `text/plain`."
                  },
                  "WebhookEvent": {
                    "type": "string",
