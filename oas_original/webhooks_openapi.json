                  },
                  "Method": {
                    "type": "string",
                    "description": "The HTTP method, which will always be `POST` in this case."
                  },
                  "ContentType": {
                    "type": "string",
                    "description": "The format you want the data to be posted in. Supported formats are `application/json`, `application/x-www-form-urlencoded`, and `text/plain`."
                  },
                  "WebhookEvent": {
                    "type": "string",
                    "description": "A number that represents the event on which the webhook will trigger.\n\n`1` \u2013 Landing page submission\n`2` \u2013 Lead activity create\n`3` \u2013 Lead create\n`4` \u2013 Lead owner change\n`5` \u2013 Lead stage change\n`6` \u2013 Lead update\n`7` \u2013 Task create\n`8` \u2013 Task reminder\n`9` \u2013 Lead score change\n`15` \u2013 Lead activity update\n`16` \u2013 Tasks complete\n`17` \u2013 Task update\n`26` \u2013 Lead field update\n`31` \u2013 Opportunity Create\n`32` \u2013 Opportunity Update\n`33` \u2013 Opportunity Field Update\n`34` \u2013 Opportunity Stage Update\n`35` \u2013 Opportunity Delete"
                  },
                  "LandingPageUrls": {
                    "type": "string",
                    "nullable": true,
                    "description": "Specifies the landing page(s) on which the event will occur if the event pertains to a landing page submission. This parameter is mandatory if `WebhookEvent` is `1` (Landing page submission)."
                  },
                  "IsSpecificLandingPage": {
                    "type": "boolean",
                    "description": "Pass `true` if a list of landing page URLs is provided in `LandingPageUrls`."
                  },
                  "NotifyOnFailure": {
                    "type": "boolean",
                    "description": "Pass `true` to ensure that you are notified whenever the webhook fails."
                  },
                  "WebhookProperties": {
                    "type": "string",
                    "nullable": true,
                    "description": "Based on what the webhook pertains to, pass the activity and opportunity details as escaped JSON. Refer to the description for examples based on webhook event type."
                  },
