                  "URL",
                  "Method",
                  "ContentType",
                  "WebhookEvent"
                ]
              },
              "example": {
                "Description": "Description of webhook",
                "URL": "https://requestb.in/19n3y3u1",
                "Method": "POST",
                "ContentType": "application/json",
                "WebhookEvent": "1",
